# Contact form delivery (server-only; never prefix these with NEXT_PUBLIC_).
# Copy to .env.local for local testing and add the same names in
# Vercel > Project > Settings > Environment Variables. Never commit real values.

# API key from https://resend.com/api-keys (secret).
RESEND_API_KEY=
# Inbox that receives messages. Without a verified domain this must be the
# email address you signed up to Resend with.
CONTACT_TO_EMAIL=
# Optional: a sender on a domain verified in Resend. Defaults to
# onboarding@resend.dev, which can only deliver to your Resend account email.
CONTACT_FROM_EMAIL=
